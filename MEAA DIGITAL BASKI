            size_hint_y=None,
            height=dp(75),
            padding=dp(10),
            spacing=dp(10)
        )

        menu = Button(
            text="☰",
            font_size=dp(26),
            size_hint_x=None,
            width=dp(55),
            background_normal="",
            background_color=BLACK,
            color=WHITE
        )

        menu.bind(
            on_press=self.menu
        )

        logo = Label(
            text="[b]MEAA[/b]\n"
                 "[color=ffad00]DIGITAL BASKI[/color]",
            markup=True,
            font_size=dp(18),
            color=BLACK,
            halign="center"
        )

        cart = Button(
            text=f"🛒 {len(self.cart)}",
            size_hint_x=None,
