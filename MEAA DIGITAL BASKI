    # ======================================================
    # ÜRÜNLERİ GÖSTER
    # ======================================================

    def show_products(
        self,
        search=""
    ):

        self.product_grid.clear_widgets()

        for product in self.products:

            if self.category != "Tümü":

                if product["category"] != \
                   self.category:

                    continue


            if search:

                if search.lower() not in \
                   product["name"].lower():

                    continue


            card = BoxLayout(
                orientation="vertical",
                padding=dp(8),
                spacing=dp(5),
                size_hint_y=None,
                height=dp(300)
            )


            # FOTOĞRAF

            if os.path.exists(
                product["image"]
            ):

                card.add_widget(
                    Image(
                        source=
                        product["image"],
                        size_hint_y=None,
                        height=dp(130)
                    )
                )

            else:

                card.add_widget(
                    Label(
                        text="🗝️",
                        font_size=dp(60),
                        size_hint_y=None,
                        height=dp(130)
                    )
                )


            # İSİM

            card.add_widget(
                Label(
                    text=product["name"],
                    color=BLACK,
                    bold=True
                )
            )


            # FİYAT

            card.add_widget(
                Label(
                    text=
                    self.price(
                        product["price"]
                    ),
                    color=BLACK,
                    font_size=dp(17)
                )
            )


            # İNCELE

            detail = Button(
                text="ÜRÜNÜ İNCELE",
                size_hint_y=None,
                height=dp(42),
                background_normal="",
                background_color=YELLOW,
                color=BLACK
            )

            detail.bind(
                on_press=
                lambda instance,
                p=product:
                self.product_detail(p)
            )

            card.add_widget(
                detail
            )


            self.product_grid.add_widget(
                card
            )


    # ======================================================
    # ARAMA
    # ======================================================

    def search_change(
        self,
        instance,
        text
    ):

        self.show_products(
            text
        )


    # ======================================================
    # KATEGORİ
    # ======================================================

    def select_category(
        self,
        category
    ):

        self.category = category

        self.show_products(
            self.search.text
        )


    # ======================================================
    # ÜRÜN DETAY
    # ======================================================

    def product_detail(
        self,
        product
    ):

        layout = BoxLayout(
            orientation="vertical",
            padding=dp(15),
            spacing=dp(10)
        )


        if os.path.exists(
            product["image"]
        ):

            layout.add_widget(
                Image(
                    source=
                    product["image"],
                    size_hint_y=None,
                    height=dp(180)
                )
            )


        layout.add_widget(
            Label(
                text=
                product["name"],
                font_size=dp(22),
                bold=True,
                color=BLACK
            )
        )


        layout.add_widget(
            Label(
                text=
                product["description"],
                color=GRAY
            )
        )


        layout.add_widget(
            Label(
                text=
                self.price(
                    product["price"]
                ),
                font_size=dp(21),
                bold=True,
                color=BLACK
            )
        )


        if product["customizable"]:

            customize = Button(
                text="✏️ KİŞİSELLEŞTİR",
                size_hint_y=None,
                height=dp(50),
                background_normal="",
                background_color=BLUE,
                color=WHITE
            )

            customize.bind(
                on_press=
                lambda instance:
                self.custom_product(
                    product
                )
            )

            layout.add_widget(
                customize
            )


        add = Button(
            text="🛒 SEPETE EKLE",
            size_hint_y=None,
            height=dp(50),
            background_normal="",
            background_color=GREEN,
            color=WHITE
        )

        add.bind(
            on_press=
            lambda instance:
            self.add_cart(product)
        )

        layout.add_widget(
            add
        )


        Popup(
            title="Ürün Detayı",
            content=layout,
            size_hint=(0.9, 0.8)
        ).open()


    # ======================================================
    # KİŞİSELLEŞTİR
    # ======================================================

    def custom_product(
        self,
        product
    ):

        layout = BoxLayout(
            orientation="vertical",
            padding=dp(15),
            spacing=dp(10)
        )

        name = TextInput(
            hint_text="İsim veya yazı",
            multiline=False
        )

        color = Spinner(
            text="Siyah",
            values=[
                "Siyah",
                "Beyaz",
                "Sarı",
                "Kırmızı",
                "Mavi",
                "Yeşil"
            ]
        )

        quantity = Spinner(
            text="1",
            values=[
                "1",
                "2",
                "3",
                "4",
                "5"
            ]
        )

        add = Button(
            text="SEPETE EKLE",
            size_hint_y=None,
            height=dp(50),
            background_normal="",
            background_color=YELLOW,
            color=BLACK
        )


        def add_custom(
            instance
        ):

            item = product.copy()

            item["custom_name"] = \
                name.text

            item["color"] = \
                color.text

            item["quantity"] = \
                int(quantity.text)

            self.cart.append(
                item
            )

            self.home()


        add.bind(
            on_press=add_custom
        )

        layout.add_widget(
            Label(
                text=
                product["name"],
                color=BLACK
            )
        )

        layout.add_widget(
            name
        )

        layout.add_widget(
            color
        )

        layout.add_widget(
            quantity
        )

        layout.add_widget(
            add
        )


        Popup(
            title="Kişiselleştir",
            content=layout,
            size_hint=(0.9, 0.7)
        ).open()


    # ======================================================
    # SEPETE EKLE
    # ======================================================

    def add_cart(
        self,
        product
    ):

        item = product.copy()

        item["quantity"] = 1

        self.cart.append(
            item
        )

        self.home()


    # ======================================================
    # SEPET TOPLAMI
    # ======================================================

    def total(self):

        total = 0

        for item in self.cart:

            total += (
                item["price"]
                *
                item.get(
                    "quantity",
                    1
                )
            )

        return total


    # ======================================================
    # SEPET
    # ======================================================

    def cart_page(
        self,
        *args
    ):

        layout = BoxLayout(
            orientation="vertical",
            padding=dp(15),
            spacing=dp(10)
        )


        if not self.cart:

            layout.add_widget(
                Label(
                    text=
                    "Sepetiniz boş.",
                    color=BLACK
                )
            )

        else:

            scroll = ScrollView()

            items = BoxLayout(
                orientation="vertical",
                size_hint_y=None,
                spacing=dp(10)
            )

            items.bind(
                minimum_height=
                items.setter(
                    "height"
                )
            )


            for index, item in \
                enumerate(
                    self.cart
                ):

                quantity = item.get(
                    "quantity",
                    1
                )

                text = (
                    f'{item["name"]}\n'
                    f'Adet: {quantity}\n'
                )

                if item.get(
                    "custom_name"
                ):

                    text += (
                        "İsim: "
                        +
                        item["custom_name"]
                        +
                        "\n"
                    )

                if item.get(
                    "color"
                ):

                    text += (
                        "Renk: "
                        +
                        item["color"]
                    )


                items.add_widget(
                    Label(
                        text=text,
                        color=BLACK,
                        size_hint_y=None,
                        height=dp(80)
                    )
                )


                remove = Button(
                    text="❌ Ürünü Kaldır",
                    size_hint_y=None,
                    height=dp(40),
                    background_normal="",
                    background_color=RED,
                    color=WHITE
                )

                remove.bind(
                    on_press=
                    lambda instance,
                    i=index:
                    self.remove_cart(i)
                )

                items.add_widget(
                    remove
                )


            scroll.add_widget(
                items
            )

            layout.add_widget(
                scroll
            )


            layout.add_widget(
                Label(
                    text=
                    "TOPLAM: "
                    +
                    self.price(
                        self.total()
                    ),
                    font_size=dp(21),
                    bold=True,
                    color=BLACK,
                    size_hint_y=None,
                    height=dp(45)
                )
            )


            order = Button(
                text="SİPARİŞ VER",
                size_hint_y=None,
                height=dp(50),
                background_normal="",
                background_color=GREEN,
                color=WHITE
            )

            order.bind(
                on_press=
                self.order_form
            )

            layout.add_widget(
                order
            )


        Popup(
            title="🛒 Sepetim",
            content=layout,
            size_hint=(0.9, 0.85)
        ).open()


    # ======================================================
    # SEPETTEN SİL
    # ======================================================

    def remove_cart(
        self,
        index
    ):

        self.cart.pop(
            index
        )

        self.home()


    # ======================================================
    # SİPARİŞ FORMU
    # ======================================================

    def order_form(
        self,
        *args
    ):

        layout = BoxLayout(
            orientation="vertical",
            padding=dp(15),
            spacing=dp(10)
        )

        name = TextInput(
            hint_text="Ad Soyad",
            multiline=False
        )

        phone = TextInput(
            hint_text="Telefon",
            multiline=False
        )

        address = TextInput(
            hint_text="Teslimat Adresi",
            multiline=True
        )

        send = Button(
            text="SİPARİŞİ TAMAMLA",
            size_hint_y=None,
            height=dp(50),
            background_normal="",
            background_color=GREEN,
            color=WHITE
        )


        def complete(
            instance
        ):

            if not name.text or \
               not phone.text or \
               not address.text:

                self.message(
                    "Lütfen tüm bilgileri doldurun."
                )

                return


            order_number = (
                "MEAA-"
                +
                datetime.now().strftime(
                    "%Y%m%d%H%M%S"
                )
            )


            order = {

                "number":
                order_number,

                "date":
                datetime.now().strftime(
                    "%d.%m.%Y %H:%M"
                ),

                "name":
                name.text,

                "phone":
                phone.text,

                "address":
                address.text,

                "total":
                self.total(),

                "status":
                "Sipariş alındı",

                "products":
                self.cart.copy()

            }


            self.orders.append(
                order
            )

            self.save_orders()

            self.cart.clear()


            self.message(
                "Siparişiniz oluşturuldu!\n\n"
                "Sipariş No:\n"
                +
                order_number
            )


        send.bind(
            on_press=complete
        )

        layout.add_widget(
            name
        )

        layout.add_widget(
            phone
        )

        layout.add_widget(
            address
        )

        layout.add_widget(
            send
        )


        Popup(
            title="Sipariş Bilgileri",
            content=layout,
            size_hint=(0.9, 0.8)
        ).open()


    # ======================================================
    # KİŞİSELLEŞTİRME
    # ======================================================

    def customize(
        self,
        *args
    ):

        self.message(
            "Kişiselleştirilebilir bir ürün seçin.\n\n"
            "Ürün detayından isim ve renk "
            "seçebilirsiniz."
        )


    # ======================================================
    # SİPARİŞLER
    # ======================================================

    def orders_page(
        self,
        *args
    ):

        if not self.orders:

            self.message(
                "Henüz siparişiniz bulunmuyor."
            )

            return


        text = ""

        for order in reversed(
            self.orders
        ):

            text += (
                "📦 "
                +
                order["number"]
                +
                "\n"
                +
                order["date"]
                +
                "\n"
                +
                order["status"]
                +
                "\n"
                +
                self.price(
                    order["total"]
                )
                +
                "\n\n"
            )


        self.message(
            text
        )


