# ==========================================================
# ANA UYGULAMA
# ==========================================================

class MeaaDigitalBaski(App):

    def build(self):

        Window.clearcolor = LIGHT

        self.products = PRODUCTS

        self.cart = []

        self.favorites = []

        self.orders = self.load_orders()

        self.category = "Tümü"

        self.root = BoxLayout(
            orientation="vertical"
        )

        self.home()

        return self.root


    # ======================================================
    # SİPARİŞLERİ YÜKLE
    # ======================================================

    def load_orders(self):

        if not os.path.exists(ORDERS_FILE):
            return []

        try:

            with open(
                ORDERS_FILE,
                "r",
                encoding="utf-8"
            ) as f:

                return json.load(f)

        except:

            return []


    # ======================================================
    # SİPARİŞ KAYDET
    # ======================================================

    def save_orders(self):

        with open(
            ORDERS_FILE,
            "w",
            encoding="utf-8"
        ) as f:

            json.dump(
                self.orders,
                f,
                ensure_ascii=False,
                indent=4
            )


    # ======================================================
    # PARA
    # ======================================================

    def price(self, value):

        return f"{value:.2f} TL"


